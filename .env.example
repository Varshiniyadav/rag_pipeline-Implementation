# ==============================================================================
# RAG Document Q&A System -- Local Configuration Example (.env.example)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#    cp .env.example .env
# 2. Fill in your local PostgreSQL 18 connection settings below.
# 3. Paste your active API keys under the API KEYS section.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL POSTGRESQL 18 DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ragdb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database Connection URL (used by SQLAlchemy Asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@localhost:5432/ragdb


# ------------------------------------------------------------------------------
# 2. REQUIRED & OPTIONAL API KEYS
# ------------------------------------------------------------------------------

# --- GROQ (Required for LLM generation) ---
GROQ_API_KEY=your_groq_api_key_here

# --- Qdrant Vector Cloud / Local DB ---
QDRANT_URL=
QDRANT_API_KEY=

# --- LlamaParse (Optional - for advanced PDF parsing) ---
LLAMAPARSE_API_KEY=

# --- LangSmith (Optional - for RAG pipeline observability and tracing) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-document-qa


# ------------------------------------------------------------------------------
# 3. SECURITY & AUTH (JWT Settings)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=change_me_to_a_random_64_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ------------------------------------------------------------------------------
# 4. APPLICATION & CORS CONFIGURATION
# ------------------------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
MAX_UPLOADS_PER_USER=10
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ------------------------------------------------------------------------------
# 5. AI MODELS CONFIGURATION (Embeddings, Re-ranking & Generation)
# ------------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DEVICE=cpu
RERANKER_MODEL=BAAI/bge-reranker-large
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048
