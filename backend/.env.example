# ═══════════════════════════════════════════════════════════════
# RAG Document Q&A System — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── API Keys ──────────────────────────────────────────────────
# REQUIRED: Groq API key for LLM inference (llama-3.3-70b-versatile)
# Get one at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# OPTIONAL: LlamaParse API key for premium PDF parsing
# Get one at: https://cloud.llamaindex.ai
# If not set, falls back to Unstructured / python-docx parsers
LLAMAPARSE_API_KEY=

# OPTIONAL: LangSmith API key for tracing & observability
# Get one at: https://smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=rag-document-qa


# ── Database (PostgreSQL) ─────────────────────────────────────
# REQUIRED: Full connection string for asyncpg driver
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Windows local example:
DATABASE_URL=postgresql+asyncpg://postgres:ragpass@localhost:5432/ragdb

# OPTIONAL: Individual DB settings (superseded by DATABASE_URL if set)
# These can be used by scripts or Docker Compose that need component values
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb


# ── Qdrant Vector Database ────────────────────────────────────
# OPTIONAL: Set QDRANT_URL to use a remote Qdrant instance (cloud or self-hosted)
# Leave both empty to use local file-based Qdrant (data stored in ./qdrant_storage)
# Qdrant Cloud: https://cloud.qdrant.io (free 1GB cluster)
#
# Examples:
#   Local Docker:   QDRANT_URL=http://localhost:6333
#   Qdrant Cloud:   QDRANT_URL=https://xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx.us-east-0-1.aws.cloud.qdrant.io
QDRANT_URL=
QDRANT_API_KEY=


# ── JWT Authentication ────────────────────────────────────────
# REQUIRED: A random 64-character string used to sign JWT tokens
# Generate with: openssl rand -hex 32  (or just type a random string)
JWT_SECRET_KEY=change_me_to_a_random_64_char_string_at_least_this_long_here

# OPTIONAL: JWT algorithm and token lifetimes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7


# ── Application Settings ──────────────────────────────────────
# OPTIONAL: Directory where uploaded files are stored
UPLOAD_DIR=./uploads

# OPTIONAL: Maximum file upload size in megabytes
MAX_FILE_SIZE_MB=50

# OPTIONAL: Maximum number of documents a single user can upload
MAX_UPLOADS_PER_USER=10

# OPTIONAL: Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000


# ── Embedding & Re-ranker ─────────────────────────────────────
# OPTIONAL: HuggingFace embedding model (sentence-transformers format)
# bge-small-en-v1.5  → 384 dimensions, fast on CPU (recommended)
# bge-large-en-v1.5  → 1024 dimensions, more accurate but slower
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OPTIONAL: Cross-encoder re-ranker model (currently disabled — using RRF fusion)
RERANKER_MODEL=BAAI/bge-reranker-large

# OPTIONAL: Device for embedding model ("cpu" or "cuda")
EMBEDDING_DEVICE=cpu


# ── LLM Configuration ─────────────────────────────────────────
# OPTIONAL: Groq model name and generation parameters
# Available models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=2048
